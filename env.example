# ─────────────────────────────────────────────────────────────────────
# SecureGuard Enterprise — Beispiel-Env-Datei
# Datei kopieren nach `.env.local` und nach Bedarf anpassen.
#   cp env.example .env.local
#   # ausfüllen → wird von Compose / Skripten gesourct
# ─────────────────────────────────────────────────────────────────────

# ─── Java / Build ────────────────────────────────────────
# JAVA_HOME=$(dirname $(dirname $(readlink -f $(which java))))

# ─── Android SDK ────────────────────────────────────────
ANDROID_HOME=${HOME}/Android/Sdk         # Default Bootstrap-Pfad
# ANDROID_SDK_ROOT=/volume/android-sdk  # alternativ für CI

# ─── Java Toolchain-Source ──────────────────────────────
JAVA_VERSION=17.0.11

# ─── Android Cmdline-Tools ─────────────────────────────
CMDLINE_TOOLS_VERSION=11076708

# ─── API-Levels ──────────────────────────────────────────
ANDROID_API_LEVEL=34
ANDROID_BUILD_TOOLS=34.0.0
MIN_API_LEVEL=26

# ─── HTTP-Proxy (optional) ─────────────────────────────
# systemProp.http.proxyHost=proxy.firma.de
# systemProp.http.proxyPort=3128

# ─── Rotation: APK-Signing (CI-only) ───────────────────
# KEYSTORE_BASE64=$(base64 -w 0 secureguard-keystore.p12)
# KEYSTORE_PASSWORD=password
# KEY_ALIAS=secureguard
# KEY_PASSWORD=password
