+name: 🛡️ CI — Lint, Tests, Build
+
+# ─────────────────────────────────────────────────────────────────────
+#  CI-Pipeline: bei jedem Push + PR
+#    1. Lint (Kotlin-Check)
+#    2. Unit-Tests (Robolectric/Standard-JUnit)
+#    3. Build Debug + Release APK
+#    4. Tests: Android-11-konform (Permission-Run vor JUnit-Run)
+# ─────────────────────────────────────────────────────────────────────
+
+on:
+  push:
+    branches: [ main, develop ]
+  pull_request:
+    branches: [ main, develop ]
+
+concurrency:
+  group: ci-${{ github.ref }}
+  cancel-in-progress: true                 # Wenn ein neuer Commit kommt, alte Bau verwerfen
+
+permissions:
+  contents: read                            # Checkout
+  packages: read                           # Registries
+  actions: read                            # Artifact-Actions
+
+jobs:
+  lint:
+    name: 〰️ Lint
+    runs-on: ubuntu-latest
+    timeout-minutes: 15
+    steps:
+      - name: Checkout
+        uses: actions/checkout@v4
+
+      - name: Setup JDK 17
+        uses: actions/setup-java@v4
+        with:
+          distribution: temurin
+          java-version: '17'
+
+      - name: Setup Gradle (Caching)
+        uses: gradle/actions/setup-gradle@v3
+        with:
+          gradle-version: 8.5
+
+      - name: Run Kotlin lint
+        run: chmod +x gradlew && ./gradlew lintDebug --no-daemon --stacktrace
+
+      - name: Upload Lint-Report
+        if: failure()
+        uses: actions/upload-artifact@v4
+        with:
+          name: lint-report
+          path: '**/build/reports/lint-results-*.html'
+          retention-days: 7
+
+  test:
+    name: 🧪 Unit-Tests (Robolectric)
+    runs-on: ubuntu-latest
+    timeout-minutes: 20
+    steps:
+      - name: Checkout
+        uses: actions/checkout@v4
+
+      - name: Setup JDK 17
+        uses: actions/setup-java@v4
+        with:
+          distribution: temurin
+          java-version: '17'
+
+      - name: Setup Gradle (Caching)
+        uses: gradle/actions/setup-gradle@v3
+        with:
+          gradle-version: 8.5
+
+      - name: Run Unit-Tests
+        run: |
+          chmod +x gradlew
+          ./gradlew :app:testDebugUnitTest --no-daemon --stacktrace
+
+      - name: Upload Test-Report
+        if: always()
+        uses: actions/upload-artifact@v4
+        with:
+          name: test-report
+          path: '**/build/reports/tests/testDebugUnitTest/**'
+          retention-days: 7
+
+  assemble:
+    name: 📦 Assemble (Debug + Release)
+    runs-on: ubuntu-latest
+    timeout-minutes: 30
+    needs: [lint, test]                       # Lint + Tests müssen ok sein
+    steps:
+      - name: Checkout
+        uses: actions/checkout@v4
+
+      - name: Setup JDK 17
+        uses: actions/setup-java@v4
+        with:
+          distribution: temurin
+          java-version: '17'
+
+      - name: Setup Gradle (Caching)
+        uses: gradle/actions/setup-gradle@v3
+        with:
+          gradle-version: 8.5
+
+      - name: Decode Keystore
+        env:
+          KEYSTORE_BASE64: ${{ secrets.KEYSTORE_BASE64 }}
+        run: |
+          if [ -n "$KEYSTORE_BASE64" ]; then
+            echo "$KEYSTORE_BASE64" | base64 -d > app/secureguard-keystore.jks
+            echo "Keystore dekodiert — Release wird signiert."
+          else
+            echo "::notice::Kein KEYSTORE_BASE64 — Release-Build bleibt unsigniert."
+          fi
+
+      - name: Build Debug-APK
+        run: chmod +x gradlew && ./gradlew assembleDebug --no-daemon --stacktrace
+
+      - name: Upload Debug-APK
+        uses: actions/upload-artifact@v4
+        with:
+          name: secureguard-debug.apk
+          path: app/build/outputs/apk/debug/*.apk
+          retention-days: 14
+
+      - name: Build Release-APK (signiert)
+        env:
+          KEYSTORE_PASSWORD: ${{ secrets.KEYSTORE_PASSWORD }}
+          KEY_ALIAS: ${{ secrets.KEY_ALIAS }}
+          KEY_PASSWORD: ${{ secrets.KEY_PASSWORD }}
+        run: ./gradlew assembleRelease --no-daemon --stacktrace
+
+      - name: Locate APK
+        id: find-apk
+        run: echo "apk_path=$(ls app/build/outputs/apk/release/*.apk | head -1)" >> "$GITHUB_OUTPUT"
+
+      - name: Upload Release-APK
+        uses: actions/upload-artifact@v4
+        with:
+          name: secureguard-pro.apk
+          path: ${{ steps.find-apk.outputs.apk_path }}
+          retention-days: 60                    # Release deutlich länger verfügbar
+
+      - name: Build-Profil-Bericht
+        if: always()
+        uses: actions/upload-artifact@v4
+        with:
+          name: build-profile
+          path: |
+            **/build/reports/profile/**/profile.html
+            **/build/outputs/apk/release/output-metadata.json
+          retention-days: 14
