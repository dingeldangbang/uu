@@ -0,0 +1,157 @@
+name: 🚀 MinPro / Release — APK Sign & Publish
+
+# ─────────────────────────────────────────────────────────────────────
+#  Release-Pipeline: bei Tag-Push (v*)
+#    1. Signierte Release-APK bauen
+#    2. GitHub-Release erstellen + APK anhängen
+#    3. Stabile Release-Notes werden via softprops/auto-generiert
+#
+#  Voraussetzung: 4 Secrets `KEYSTORE_BASE64`, `KEYSTORE_PASSWORD`,
+#                 `KEY_ALIAS`, `KEY_PASSWORD` müssen gesetzt sein
+#  (siehe README § GitHub Secrets)
+# ─────────────────────────────────────────────────────────────────────
+
+on:
+  push:
+    tags: [ 'v*' ]                            # v1.0.0, v1.2.3-rc1, ...
+  workflow_dispatch:                          # Manuelle Releases über das UI
+    inputs:
+      pre_release:
+        description: "Pre-Release markieren (optional)"
+        required: false
+        type: boolean
+        default: false
+
+concurrency:
+  group: release-${{ github.ref }}
+  cancel-in-progress: false                  # Release nicht abbrechen
+
+permissions:
+  contents: write                            # Tag + Release erstellen
+  packages: read
+
+jobs:
+  build:
+    name: 📦 Build + Sign
+    runs-on: ubuntu-latest
+    timeout-minutes: 30
+    steps:
+      - name: Checkout
+        uses: actions/checkout@v4
+
+      - name: Setup JDK 17
+        uses: actions/setup-java@v4
+        with:
+          distribution: temurin
+          java-version: '17'
+
+      - name: Setup Gradle (Caching)
+        uses: gradle/actions/setup-gradle@v3
+        with:
+          gradle-version: 8.5
+
+      - name: Decode Keystore
+        env:
+          KEYSTORE_BASE64: ${{ secrets.KEYSTORE_BASE64 }}
+        run: echo "$KEYSTORE_BASE64" | base64 -d > app/secureguard-keystore.jks
+
+      - name: Build signed APK
+        env:
+          KEYSTORE_PASSWORD: ${{ secrets.KEYSTORE_PASSWORD }}
+          KEY_ALIAS: ${{ secrets.KEY_ALIAS }}
+          KEY_PASSWORD: ${{ secrets.KEY_PASSWORD }}
+        run: |
+          chmod +x gradlew
+          ./gradlew assembleRelease --no-daemon --stacktrace
+
+      - name: Finde Release-APK
+        id: find-apk
+        run: |
+          APK=$(ls app/build/outputs/apk/release/*.apk 2>/dev/null | head -1)
+          if [ -z "$APK" ]; then
+            echo "::error::Keine Release-APK unter app/build/outputs/apk/release/"
+            exit 1
+          fi
+          TARGET="app/build/outputs/apk/release/secureguard-pro-${GITHUB_REF_NAME}.apk"
+          [ "$APK" = "$TARGET" ] || mv "$APK" "$TARGET"
+          echo "apk_path=$TARGET" >> "$GITHUB_OUTPUT"
+          echo "apk_name=$(basename "$TARGET")" >> "$GITHUB_OUTPUT"
+
+      - name: Upload APK als Artifact (Vor-Release-Check)
+        uses: actions/upload-artifact@v4
+        with:
+          name: secureguard-pro-${{ github.ref_name }}.apk
+          path: ${{ steps.find-apk.outputs.apk_path }}
+          retention-days: 90
+
+  publish-release:
+    name: 📤 GitHub Release
+    runs-on: ubuntu-latest
+    timeout-minutes: 10
+    needs: build
+    steps:
+      - name: Download APK
+        uses: actions/download-artifact@v4
+        with:
+          name: secureguard-pro-${{ github.ref_name }}.apk
+          path: ./apk
+
+      - name: Build-Info sammeln
+        id: build-info
+        run: |
+          APK=$(ls ./apk/*.apk | head -1)
+          SIZE=$(stat -c%s "$APK")
+          SHA=$(sha256sum "$APK" | cut -d' ' -f1)
+          echo "apk_size=$SIZE" >> "$GITHUB_OUTPUT"
+          echo "apk_sha256=$SHA" >> "$GITHUB_OUTPUT"
+          echo "✓ APK: $APK ($SIZE bytes) sha256=$SHA"
+
+      - name: Build-Info als Artifact sichern (audit)
+        uses: actions/upload-artifact@v4
+        with:
+          name: build-info
+          path: build-info.json
+        if: false                                 # wir embedded unten in Release-Body
+
+      - name: GitHub Release erstellen
+        uses: softprops/action-gh-release@v2
+        with:
+          name: "🛡️ wischiwaschi Pro ${{ github.ref_name }}"
+          body: |
+            ## 🛡️ wischiwaschi — ${{ github.ref_name }}
+
+            **Build:**   ${{ github.workflow }} · ${{ github.run_id }}  
+            **Commit:**  ${{ github.sha }}  
+            **Datum:**   ${{ github.event.repository.updated_at }}  
+            **Größe:**   ${{ steps.build-info.outputs.apk_size }} bytes  
+            **SHA-256:** `${{ steps.build-info.outputs.apk_sha256 }}`
+
+            ### ✅ Funktionen
+            - 📡 LoRa/LoRaWAN (`LoraService` – Stub, Hardware-Bridge nachrüstbar)
+            - 🧠 Selbstlernender Agent (`SecureAgentWorker` mit ε-greedy Q-Learning)
+            - 🗺️ OpenStreetMap-Karte (`osmdroid` + Marker-Drawables)
+            - 🎮 Fernsteuerung (8 Aktionen: ALARM / LIGHT / MOTOR_OFF / BATTERY / MESSAGE / POSITION / RESTART / TELEMETRY)
+            - 👁️ Optische Erkennung (`CameraX` + `ML Kit ObjectDetector` live)
+            - 🌍 Apple/Google-Crowdsourcing (Retrofit REST-Client, `externalAllowed`-Gate)
+            - 🏙️ Urbane Infrastruktur (`WifiManager` + `TelephonyManager`)
+            - 📡 GPS / GLONASS / Galileo (`FusedLocationProviderClient`, Multi-Konstellation)
+            - 🗺️ API-Node-Manager (11 Knoten: WiGle, DHL, Mosquitto, …)
+            - 🔐 Honeywell-Datacollection SDK (CT45P-Scanner, Lifecycle-bound)
+            - 📧 Temporäre E-Mail / OTP-Registrierung (MCP + REST)
+
+            ### 📦 Downloads
+            - **APK**: `secureguard-pro-${{ github.ref_name }}.apk`
+
+            ### 📋 Installation
+            ```
+            adb install -r secureguard-pro-${{ github.ref_name }}.apk
+            adb shell am start -n com.secureguard.enterprise/.presentation.MainActivity
+            ```
+
+            ### 🐛 Bug-Reports
+            Bitte via GitHub Issues in `${{ github.repository }}`.
+          files: |
+            ./apk/*.apk
+          draft: false
+          prerelease: ${{ github.event.inputs.pre_release == 'true' }}
+          generate_release_notes: true
